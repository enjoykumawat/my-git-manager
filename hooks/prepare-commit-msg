#!/bin/sh
# AI commit message pre-fill via Claude CLI
# Skips merge commits, squash, and amend
[ "$2" = "" ] || exit 0

# Resolve git_commit.py via the repo root, not via $0's own location.
# The 2026-07-31 fix computed this as `dirname "$0")/../..`, tuned for
# exactly one install method (scripts/install-hooks.sh copying this file
# into .git/hooks/, one level deeper than its tracked home in <repo>/hooks/).
# README.md documents a second method — `git config core.hooksPath
# <repo>/hooks` — that invokes this file straight from its tracked
# location, one level shallower, so the same "../.." overshoots by one
# directory there and silently can't find git_commit.py. `git
# rev-parse --show-toplevel` finds the repo root directly, independent of
# where git happened to invoke this file from, so it's correct under both
# documented install methods (and any other). See docs/project_notes/bugs.md
# 2026-08-04.
SCRIPT="$(git rev-parse --show-toplevel)/git_commit.py"
MSG="$(python "$SCRIPT" 2>/dev/null)" && [ -n "$MSG" ] && printf '%s\n' "$MSG" > "$1"
exit 0
